{
  "apiKeyHelper": "airnity auth print-access-token",
  "companyAnnouncements": [
    "Airnity: this Claude Code session is routed through Bifrost (per-token billing)."
  ],
  "disableArtifact": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "env": {
    "ANTHROPIC_BASE_URL": "https://bifrost.airnity.io/anthropic",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "vertex/claude-fable[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "vertex/claude-haiku",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "vertex/claude-opus[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "vertex/claude-sonnet[1m]",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "deny": [
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "SendUserFile"
    ]
  }
}
