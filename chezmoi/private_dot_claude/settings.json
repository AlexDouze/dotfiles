{
  "apiKeyHelper": "airnity auth print-access-token",
  "autoUpdatesChannel": "latest",
  "effort": "xhigh",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "bifrost@airnity-plugins": true,
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_BASE_URL": "https://bifrost.airnity.io/anthropic",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "vertex/claude-fable-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "vertex/claude-haiku-4-5@20251001",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "vertex/claude-opus-4-8[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "vertex/claude-sonnet-5[1m]",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff",
            "async": true
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "mcp__bifrost__listToolFiles",
      "mcp__bifrost__readToolFile",
      "mcp__bifrost__executeToolCode",
      "mcp__bifrost__getToolDocs"
    ],
    "deny": []
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "starship statusline claude-code"
  },
  "useAutoModeDuringPlan": true
}
