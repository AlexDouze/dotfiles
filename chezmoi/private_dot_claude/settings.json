{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "mcp__bifrost__listToolFiles",
      "mcp__bifrost__readToolFile",
      "mcp__bifrost__executeToolCode",
      "mcp__bifrost__getToolDocs"
    ],
    "deny": [
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "ListAgents",
      "NotebookEdit",
      "SendMessage",
      "ShareOnboardingGuide"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "disableBundledSkills": true,
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "airnity ai llms-txt 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff",
            "async": true
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "starship statusline claude-code"
  },
  "enabledPlugins": {
    "bifrost@airnity-plugins": true,
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}
