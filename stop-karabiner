#!/bin/bash
# Stops the root-owned Karabiner-Elements LaunchDaemons that keep running
# after quitting the Karabiner-Elements menu bar app.
#
# Note: the org.pqrs.Karabiner-DriverKit-VirtualHIDDevice system extension
# (_driverkit process) is not stopped here — it can only be unloaded via
# System Settings > Privacy & Security > Driver Extensions, or by fully
# uninstalling Karabiner-Elements (requires a reboot).
set -euo pipefail

DAEMONS=(
  org.pqrs.service.daemon.Karabiner-Core-Service
  org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon
)

for daemon in "${DAEMONS[@]}"; do
  if sudo launchctl print "system/${daemon}" >/dev/null 2>&1; then
    echo "Stopping ${daemon}..."
    sudo launchctl bootout "system/${daemon}"
  else
    echo "${daemon} is not running, skipping."
  fi
done

echo "Done. Remaining karabiner processes:"
ps aux | grep -i karabiner | grep -v grep || echo "(none)"
